# [Task]: T010 [From]: spec.md FR-010, data-model.md §7
# Example secrets template - DO NOT commit with real values
# Copy this file to app-secrets.yaml and fill in your values
#
# Alternative: Create secrets via kubectl:
#   kubectl create secret generic todo-secrets \
#     --namespace=todo-app \
#     --from-literal=DATABASE_URL='your-neon-connection-string' \
#     --from-literal=OPENAI_API_KEY='your-openai-api-key' \
#     --from-literal=BETTER_AUTH_SECRET='your-better-auth-secret'
#
apiVersion: v1
kind: Secret
metadata:
  name: todo-secrets
  namespace: todo-app
  labels:
    app.kubernetes.io/name: todo-chatbot
    app.kubernetes.io/part-of: todo-app
type: Opaque
stringData:
  # Neon PostgreSQL connection string
  # Format: postgresql://user:password@host/database?sslmode=require
  DATABASE_URL: "postgresql://your-user:your-password@your-host.neon.tech/your-database?sslmode=require"

  # OpenAI API key for chatbot functionality
  OPENAI_API_KEY: "sk-your-openai-api-key"

  # Better Auth JWT signing secret (must match frontend)
  BETTER_AUTH_SECRET: "your-better-auth-secret-min-32-characters"
